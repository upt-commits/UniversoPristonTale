PORT=3001
HOST=127.0.0.1
NODE_ENV=development
SQL_SERVER=(local)
SQL_USER=your_sql_user
SQL_PASSWORD=your_sql_password
SQL_DATABASE_GAME=UserDB
SQL_DATABASE_PORTAL=UPTPortal
# 32-byte hex keys — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_HMAC_KEY=replace_with_64_char_hex_key
FIELD_ENCRYPTION_KEY=replace_with_64_char_hex_key
SESSION_SECRET=replace_with_64_char_hex_key
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
PORTAL_PUBLIC_URL=https://www.yourdomain.com
