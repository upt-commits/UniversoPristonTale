PORT=3001
HOST=127.0.0.1

# SQL Server
SQL_SERVER=(local)
SQL_USER=CHANGE_ME
SQL_PASSWORD=CHANGE_ME
SQL_DATABASE_GAME=UserDB
SQL_DATABASE_PORTAL=UPTPortal

# Application environment
APP_ENV=development
NODE_ENV=development

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_NAME=upt_sid
SESSION_TTL_MINUTES=1440

# Cryptographic keys (32-byte hex)
CPF_HMAC_KEY=CHANGE_ME
FIELD_ENCRYPTION_KEY=CHANGE_ME
SESSION_SECRET=CHANGE_ME

# SMTP (production e-mail)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@universopt.com.br
SMTP_REPLY_TO=suporte@universopt.com.br
SMTP_CONNECTION_TIMEOUT=10000
SMTP_SEND_TIMEOUT=15000

# OTP settings
OTP_ENABLED=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5

# CAPTCHA (Cloudflare Turnstile)
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=CHANGE_ME
CAPTCHA_SECRET_KEY=CHANGE_ME
CAPTCHA_REQUIRED=true
ALLOW_DEV_CAPTCHA_BYPASS=false

# Portal URL (for CORS, CSRF, links)
PORTAL_PUBLIC_URL=https://universopt.com.br

# Trust proxy (number of hops or specific IPs)
TRUST_PROXY=1

# Feature flags
REGISTRATION_ENABLED=true

# Server status monitoring
STATUS_CACHE_TTL_SECONDS=10
STATUS_STALE_THRESHOLD_SECONDS=60
STATUS_UPDATE_INTERVAL_SECONDS=15
LOGIN_SERVER_HOST=127.0.0.1
LOGIN_SERVER_PORT=10009
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=30010
SERVER_MAX_CAPACITY=1000
