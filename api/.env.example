PORT=3001
HOST=127.0.0.1
NODE_ENV=development
APP_ENV=development

PORTAL_PUBLIC_URL=http://localhost:3000

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_NAME=upt_sid
SESSION_TTL_MINUTES=1440

# Trust proxy (1 = behind one reverse proxy like IIS)
TRUST_PROXY=1

# SQL Server
SQL_SERVER=(local)
SQL_USER=your_sql_user
SQL_PASSWORD=your_sql_password
SQL_DATABASE_PORTAL=UPTPortal
SQL_DATABASE_GAME=UserDB
SQL_DATABASE_CLAN=ClanDB

# 32-byte hex keys — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_HMAC_KEY=replace_with_64_char_hex_key
FIELD_ENCRYPTION_KEY=replace_with_64_char_hex_key
SESSION_SECRET=replace_with_64_char_hex_key

# SMTP (leave empty to disable email features)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_REPLY_TO=
SMTP_CONNECTION_TIMEOUT=10000
SMTP_SEND_TIMEOUT=15000

# OTP email verification
OTP_ENABLED=false
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5

# Captcha (Cloudflare Turnstile)
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_REQUIRED=false
ALLOW_DEV_CAPTCHA_BYPASS=false

# Registration
REGISTRATION_ENABLED=true

# Server status monitoring
STATUS_CACHE_TTL_SECONDS=10
STATUS_STALE_THRESHOLD_SECONDS=60
STATUS_UPDATE_INTERVAL_SECONDS=15
LOGIN_SERVER_HOST=127.0.0.1
LOGIN_SERVER_PORT=10009
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=30010
SERVER_MAX_CAPACITY=1000

STATUS_STATE_FILE=C:\UPT\State\server-status.json
STATUS_COLLECT_INTERVAL_MS=7500
STATUS_DEPENDENCY_TIMEOUT_MS=10000
STATUS_MAX_AGE_MS=45000
STATUS_HEARTBEAT_MAX_AGE_MS=30000
STATUS_SUCCESS_THRESHOLD=2
STATUS_FAILURE_THRESHOLD=2
STATUS_HMAC_SECRET=replace_with_64_char_hex_key
