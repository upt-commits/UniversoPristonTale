<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="UPT Monitor HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^monitor\.universopt\.com\.br$" ignoreCase="true" />
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
            <add input="{URL}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://monitor.universopt.com.br/{R:1}" redirectType="Permanent" />
        </rule>

        <rule name="UPT Status Monitor" stopProcessing="true">
          <match url="^api/internal(?:/(.*))?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^monitor\.universopt\.com\.br$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:3001/api/internal/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="UPT API Cadastro" stopProcessing="true">
          <match url="^api(?:/(.*))?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^(www\.)?universopt\.com\.br$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:3001/api/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="UPT Portal Next.js" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^(www\.)?universopt\.com\.br$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
